data/aster/
data/sites/*/aster/
data/sites/*/rasters/
data/dem/
data/*.csv
data/mrds/*.csv
data/*.h5

# Per-site Esri World Imagery cache (regenerable via basemap.py); keep the
# committed US state-boundary GeoJSON that Figure 1 needs for offline rendering.
data/basemap/*/
!data/basemap/us_states.geojson

# Ad-hoc analysis-chain logs written to the repo root during long re-runs
scratch_*
*.scratch.log
scripts/*.log

# ---------------------------------------------------------------------------
# Pre-publication / internal working material — NOT for the public portfolio repo.
# These hold unpublished results, candid self-assessment, manuscript drafts, and
# forward-looking research strategy. Keep local; do not commit until publication.
# ---------------------------------------------------------------------------
paper/
docs/publication_audit.md
docs/publication_readiness_report.md
docs/expansion_plan_100_sites.md
docs/expansion_candidates.md
docs/session_handoff.md
docs/learning_log.md
docs/what_i_learned.md
