data/aster/
data/sites/*/aster/
data/sites/*/rasters/
data/dem/
data/*.csv
data/mrds/*.csv
data/*.h5

# Per-site Esri World Imagery cache (regenerable via basemap.py); keep the
# committed US state-boundary GeoJSON that Figure 1 needs for offline rendering.
data/basemap/*/
!data/basemap/us_states.geojson

# Cached CMR granule-footprint responses backing scripts/gemx_coverage_report.py.
# Regenerable with no credentials (CMR metadata search is public); a full
# 109-site refresh takes ~3 min, versus ~15 s from this cache.
data/gemx/

# Cached USMIN WFS (GML) and Overpass (JSON) responses for MRDS verification.
data/usmin/

# Cached CMR granule-metadata responses backing scripts/audit_granule_cloud_cover.py
# (public, regenerable with no credentials).
data/cmr_cache/

# Per-site SGMC geologic-unit polygons (regenerable via scripts/lithology_matched_null.py)
data/lithology/

# AG100 v003 emissivity tiles (~44 MB each; regenerable via critical_minerals_aster.ag100)
data/ag100/

# Ad-hoc analysis-chain logs written to the repo root during long re-runs
scratch_*
*.scratch.log
scripts/*.log

# Agent implementation plans. Working notes, not part of the public method.
docs/superpowers/

# Regenerable EMIT pilot rasters and the prospectivity feature store / map GeoTIFFs.
data/emit/
data/prospectivity/

# Local pre-destripe comparison tables. Same role as the other results/ baselines.
results/_baseline_pre_destripe/

# ---------------------------------------------------------------------------
# Pre-publication / internal working material — NOT for the public portfolio repo.
# These hold unpublished results, candid self-assessment, manuscript drafts, and
# forward-looking research strategy. Keep local; do not commit until publication.
# ---------------------------------------------------------------------------
paper/
docs/publication_audit.md
docs/publication_readiness_report.md
docs/expansion_plan_100_sites.md
docs/expansion_candidates.md
docs/session_handoff.md
docs/learning_log.md
docs/what_i_learned.md
