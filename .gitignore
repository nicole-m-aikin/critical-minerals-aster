*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
data/mrds.csv
data/mrds_mcdermitt.geojson
results/*.csv
results/*.parquet
results/*.json
!results/.gitkeep

# Per-site figure galleries: regenerable via `run --site {id}`, not worth versioning
# at 100+ sites (~10 MB/site). The original 45 sites' galleries stay tracked (already
# public, untouched by this rule — .gitignore never untracks an already-tracked file);
# this only stops NEW site galleries from being added going forward.
figures/sites/
.DS_Store
.netrc
.claude/
INTERVIEW_PREP.md

# Raw ASTER granules (archived radiance, clear-day L1T, night AST_05); recorded in data/MANIFEST.sha256
data/sites/*/aster_archive_pre_clearday/
data/sites/*/aster_l1t_day/
data/sites/*/aster_night/

# AI-assistant instructions and batch-run logs (local only)
CLAUDE.md
logs/
*.log
.ruff_cache/
.mypy_cache/
